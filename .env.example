# Copy this file to .env and fill in real values before running docker compose.
# .env should NOT be committed to git (already covered by a broad .gitignore rule if you add "*.env").

# Used by login_service to sign/verify JWTs. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# Shared secret for trusted service-to-service calls (Evaluation -> Question, Result -> Evaluation, etc.)
# In a production ZTA system this would be short-lived, per-service, and mTLS-backed —
# this static token is a documented scope limitation for the research prototype.
INTERNAL_SERVICE_TOKEN=change-me-to-a-different-long-random-string
